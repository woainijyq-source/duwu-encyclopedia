# 奇妙毒物科学游乐园 · 自建免费 VoxCPM2 云端语音 & DeepSeek AI 配置示例 (切勿在此示例文件填写生产密钥！)
# 生产环境存储于服务器 /www/wwwroot/duwu-encyclopedia/shared-data/tts.env (chmod 600)
# 优先使用自建 0 成本云端 VoxCPM2（同机可填 http://127.0.0.1:18888/tts/v1/audio/speech）
VOXCPM_TTS_ENDPOINT=http://127.0.0.1:18888/tts/v1/audio/speech
VOXCPM_TTS_KEY=
VOXCPM_TTS_VOICE=doubao_vivi
# 可选备用：火山引擎豆包 seed-tts-2.0
VOLC_TTS_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_xiaohe_uranus_bigtts
VOLC_TTS_RATE=-5
TTS_PER_IP_HOUR=240
TTS_PER_DAY=1500
AI_BASE=https://doudou-newapi.com
AI_KEY=
AI_MODEL=DeepSeek-V4.1-Flash
CHAT_PER_IP_HOUR=120
CHAT_PER_DAY=600
